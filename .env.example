# TradeMe API Credentials
# Get these from: https://www.trademe.co.nz/developers/api-overview/register-your-application
TRADEME_CONSUMER_KEY=your_consumer_key_here
TRADEME_CONSUMER_SECRET=your_consumer_secret_here

# Set to 'sandbox' for testing or 'production' for live
TRADEME_ENVIRONMENT=sandbox

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex())")
SECRET_KEY=change_this_to_a_random_secret_key

# Optional: OAuth tokens if you want to pre-configure (normally set via web flow)
# TRADEME_OAUTH_TOKEN=
# TRADEME_OAUTH_TOKEN_SECRET=
